# Copy to .env and fill in. Everything here has a working default except Mailgun.
NODE_ENV=development
PORT=3000

# Absolute origin, no trailing slash. Drives canonical, hreflang and sitemap.
SITE_URL=http://localhost:3000
APP_URL=https://portal.ekteb.ai/login

# Interface to bind. 0.0.0.0 is required in a container; 127.0.0.1 is fine
# locally if you do not want the dev server reachable from your network.
HOST=0.0.0.0

# schema.org sameAs — the profiles that tie this site to the company search
# engines already know. Comma-separated, e.g.
# SOCIAL_PROFILES=https://www.linkedin.com/company/ekteb,https://x.com/ekteb
SOCIAL_PROFILES=

# --- /feeds ------------------------------------------------------------------
# The platform API the feeds page reads. Left empty, the page shows the sample
# items in src/data/feeds.sample.json and is kept out of search (noindex, and
# absent from the sitemap) so placeholder content never gets indexed.
FEEDS_API_URL=
# FEEDS_API_KEY=             # sent as "Authorization: Bearer <key>" if set
# FEEDS_LIMIT=24
# FEEDS_CACHE_SECONDS=120    # served stale while a refresh runs behind it
# FEEDS_TIMEOUT_MS=5000
# Origins the video files and thumbnails are served from. CSP blocks the rest.
# FEEDS_MEDIA_ORIGINS=https://ekteb-01.fra1.digitaloceanspaces.com

# --- Mailgun -----------------------------------------------------------------
# The contact form has no database behind it: this email IS the lead. Leave it
# unset in development and submissions are logged to the console instead; in
# production an unset key makes the form answer 503 rather than pretend.
#
# API key:  Mailgun dashboard → Send → API keys  (starts with "key-" on the
#           classic keys, or a long token on the newer ones)
# Domain:   the sending domain exactly as Mailgun lists it — ekteb.ai here.
#           NOT the API URL: that is what MAILGUN_REGION selects.
# Region:   us or eu — must match where the domain was created, or Mailgun
#           answers 401 as if the key were wrong.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=ekteb.ai
MAILGUN_REGION=eu
# MAILGUN_API_BASE=          # optional override; region sets this normally
MAILGUN_TIMEOUT_MS=10000

# MAIL_FROM must be on the Mailgun domain above (or an authorised sender).
MAIL_FROM=Ekteb <no-reply@ekteb.ai>
# Where the leads land. Required — no address, no delivery.
MAIL_TO=
