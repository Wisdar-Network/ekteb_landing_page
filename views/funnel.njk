<!-- Frames the monitoring screen samples from. Never displayed on their own. -->
<div id="pool" hidden aria-hidden="true">
  <img src="data:image/webp;base64," alt="" width="280" height="158">
  <img src="data:image/webp;base64," alt="" width="130" height="76">
  <img src="data:image/webp;base64," alt="" width="130" height="76">
  <img src="data:image/webp;base64," alt="" width="130" height="76">
  <img src="data:image/webp;base64," alt="" width="130" height="76">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
  <img src="data:image/webp;base64," alt="" width="148" height="92">
</div>

<div class="scroller" id="scroller">
<main class="stage">
  <div class="stage__inner">

    <div class="stage__bar">
      <span class="statuspill" id="fnStatus" role="status" aria-live="polite">
        <span class="dot"></span><span id="fnStatusText"></span>
      </span>
    </div>

    <p class="sr-only">{{ t.funnel.srDesc }}</p>

    <div class="fn" id="fn" aria-hidden="true">

      <!-- ١ · شاشة الرصد -->
      <div class="fn__tier fn__tier--a">
        <span class="fn__ttl">{{ t.funnel.t1 }}</span>
        <span class="fn__cap">
          <span class="fn__num" id="fnNum">0</span>
          <span class="fn__lbl">{{ t.funnel.t1lbl }}</span>
        </span>
        <div class="fn__panel"><div class="fn__stream" id="fnStream"><div class="fn__mosaic" id="fnMosaic"></div></div></div>
      </div>

      <div class="fn__link fn__link--1" id="fnLink1">
        <svg aria-hidden="true"><path/><path/><path/></svg>
      </div>

      <!-- ٢ · المرتَّب حسب الأولوية -->
      <div class="fn__tier fn__tier--b">
        <span class="fn__ttl">{{ t.funnel.t2 }}</span>
        <span class="fn__cap">
          <span class="fn__num">200</span>
          <span class="fn__lbl">{{ t.funnel.t2lbl }}</span>
        </span>
        <div class="fn__panel">
          <div class="fn__sorted" id="fnSorted">
            <span class="fn__row" data-pick="1">
              <span class="fn__row-thumb"><img src="data:image/webp;base64," alt="" width="280" height="121" decoding="async"></span>
              <span class="fn__row-body">
                <span class="fn__row-meta"><bdi>aljazeera.net</bdi> · {{ t.funnel.kindVideo }} · <bdi>02:34</bdi></span>
                <span class="fn__row-txt">{{ t.funnel.rows[0] }}</span>
              </span>
              <span class="chip chip--brand">{{ t.funnel.chipSuggested }}</span>
            </span>

            <span class="fn__row">
              <span class="fn__row-thumb fn__row-thumb--doc"><span class="fn__doc"><i></i><i></i><i></i></span></span>
              <span class="fn__row-body">
                <span class="fn__row-meta"><bdi>france24.com</bdi> · {{ t.funnel.kindArticle }}</span>
                <span class="fn__row-txt">{{ t.funnel.rows[1] }}</span>
              </span>
              <span class="chip chip--warning">{{ t.funnel.chipPriority }}</span>
            </span>

            <span class="fn__row">
              <span class="fn__row-thumb fn__row-thumb--doc"><span class="fn__doc"><i></i><i></i><i></i></span></span>
              <span class="fn__row-body">
                <span class="fn__row-meta"><bdi>aa.com.tr</bdi> · {{ t.funnel.kindReport }}</span>
                <span class="fn__row-txt">{{ t.funnel.rows[2] }}</span>
              </span>
              <span class="chip chip--info">{{ t.funnel.chipNew }}</span>
            </span>

            <span class="fn__row">
              <span class="fn__row-thumb"><img src="data:image/webp;base64," alt="" width="280" height="158" decoding="async"></span>
              <span class="fn__row-body">
                <span class="fn__row-meta"><bdi>trtarabi.com</bdi> · {{ t.funnel.kindVideo }} · <bdi>04:12</bdi></span>
                <span class="fn__row-txt">{{ t.funnel.rows[3] }}</span>
              </span>
              <span class="chip chip--success">{{ t.funnel.chipReviewed }}</span>
            </span>

            <span class="fn__row">
              <span class="fn__row-thumb"><img src="data:image/webp;base64," alt="" width="130" height="76" decoding="async"></span>
              <span class="fn__row-body">
                <span class="fn__row-meta"><bdi>noonpost.com</bdi> · {{ t.funnel.kindVideo }} · <bdi>03:05</bdi></span>
                <span class="fn__row-txt">{{ t.funnel.rows[4] }}</span>
              </span>
              <span class="chip chip--neutral">{{ t.funnel.chipSaved }}</span>
            </span>
          </div>
        </div>
      </div>

      <div class="fn__link fn__link--2" id="fnLink2">
        <svg aria-hidden="true"><path/></svg>
      </div>

      <!-- ٣ · المادة الجاهزة -->
      <div class="fn__tier fn__tier--c">
        <span class="fn__ttl">{{ t.funnel.t3 }}</span>
        <span class="fn__cap">
          <span class="fn__num">1</span>
          <span class="fn__lbl">{{ t.funnel.t3lbl }}</span>
        </span>
        <div class="fn__panel fn__panel--out">
          <div class="fn__out">
            <div class="fn__prev">
              <img src="data:image/webp;base64," alt="" width="280" height="121" decoding="async">
              <span class="fn__brand" id="fnBrand"></span>
              <span class="fn__top" id="fnTop">
                <svg style="--logo-mark:#cfc4e2;color:#fff" aria-hidden="true"><use href="#ekteb-logo"></use></svg>
                <span>{{ t.funnel.source }} · <bdi>02:34</bdi></span>
              </span>
              <span class="fn__sub" id="fnSub">{{ t.funnel.sub }}</span>
            </div>
            <div class="fn__steps" id="fnSteps">
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[0] }}</span>
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[1] }}</span>
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[2] }}</span>
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[3] }}</span>
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[4] }}</span>
              <span class="fn__step"><span class="tick"><svg aria-hidden="true"><use href="#i-check"></use></svg></span>{{ t.funnel.steps[5] }}</span>
            </div>
            <div class="fn__chans" id="fnChans">
              <span class="chip chip--neutral"><bdi>YouTube</bdi></span>
              <span class="chip chip--neutral"><bdi>Facebook</bdi></span>
              <span class="chip chip--neutral"><bdi>Instagram</bdi></span>
              <span class="chip chip--neutral"><bdi>TikTok</bdi></span>
              <span class="chip chip--neutral"><bdi>X</bdi></span>
              <span class="chip chip--neutral"><bdi>Telegram</bdi></span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>
<div class="scroll-space" aria-hidden="true"></div>
</div>
<div class="scroll-hint" id="scrollHint" aria-hidden="true">{{ t.funnel.scroll }}</div>
<script id="funnel-i18n" type="application/json">{{ {
  "watch": t.funnel.watch,
  "drop": t.funnel.drop,
  "ranked": t.funnel.ranked,
  "pick": t.funnel.pick,
  "s": t.funnel.steps
} | dump | safe }}</script>
{% endblock %}

{% block scripts %}
<script src="/js/funnel.js"></script>
{% endblock %}
