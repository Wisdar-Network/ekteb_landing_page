{% extends "layout.njk" %}

{# The funnel keeps its own document: its engine reads a private scroll
   timeline, and the host page drives it through postMessage. #}

{% block title %}{{ t.funnel.title }}{% endblock %}

{# Rendered inside the landing page's iframe, so it must not compete with
   /:locale in search results. #}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Baloo+2:wght@600;700&family=Roboto+Slab:wght@300..700&display=swap">
<link rel="stylesheet" href="/css/funnel.css">
{% endblock %}

