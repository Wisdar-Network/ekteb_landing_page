{% extends "layout.njk" %}

{% block bodyattrs %} id="top"{% endblock %}

{# The hero screenshot is the LCP element on every viewport. Preloading it
   starts the fetch during head parsing instead of after layout. There is one
   screenshot per locale, plus a simpler phone version; the media queries must
   match the <source> in partials/hero.njk or the browser fetches both. #}
{# The srcset/sizes here must stay identical to the image's, or the preload
   fetches a size the image then ignores. #}
{% block preload %}<link rel="preload" as="image" href="{{ asset('/media/opt/hero-app-' + locale + '-1100.webp') }}" imagesrcset="{{ asset('/media/opt/hero-app-' + locale + '-800.webp') }} 800w, {{ asset('/media/opt/hero-app-' + locale + '-1100.webp') }} 1100w, {{ asset('/media/opt/hero-app-' + locale + '-1500.webp') }} 1500w, {{ asset('/media/opt/hero-app-' + locale + '.webp') }} 2000w" imagesizes="(max-width:1023px) 100vw, min(94vw, 100vh, 1070px)" type="image/webp" media="(min-width:768px)" fetchpriority="high">
<link rel="preload" as="image" href="{{ asset('/media/opt/hero-app-' + locale + '-m.webp') }}" imagesrcset="{{ asset('/media/opt/hero-app-' + locale + '-m-400.webp') }} 400w, {{ asset('/media/opt/hero-app-' + locale + '-m-800.webp') }} 800w, {{ asset('/media/opt/hero-app-' + locale + '-m.webp') }} 1200w" imagesizes="100vw" type="image/webp" media="(max-width:767px)" fetchpriority="high">{% endblock %}

{% block body %}
{% include "partials/header.njk" %}
<main>
{% include "partials/hero.njk" %}
{% include "partials/problem.njk" %}
{% include "partials/steps.njk" %}
{% include "partials/feed.njk" %}
{% include "partials/features.njk" %}
{% include "partials/usecases.njk" %}
{% include "partials/enterprise.njk" %}
{% include "partials/faq.njk" %}
{% include "partials/contact.njk" %}
</main>
{% include "partials/footer.njk" %}
{% endblock %}

{% block scripts %}
<script src="{{ asset('/js/site.js') }}" defer></script>
{% endblock %}
