{% extends "layout.njk" %}

{% block bodyattrs %} id="top"{% endblock %}

{# The hero screenshot is the LCP element on every viewport. Preloading it
   starts the fetch during head parsing instead of after layout. #}
{% block preload %}<link rel="preload" as="image" href="/media/opt/hero-app.webp" type="image/webp" fetchpriority="high">{% endblock %}

{% block body %}
{% include "partials/header.njk" %}
<main>
{% include "partials/hero.njk" %}
{% include "partials/problem.njk" %}
{% include "partials/steps.njk" %}
{% include "partials/feed.njk" %}
{% include "partials/features.njk" %}
{% include "partials/usecases.njk" %}
{% include "partials/enterprise.njk" %}
{% include "partials/faq.njk" %}
{% include "partials/contact.njk" %}
</main>
{% include "partials/footer.njk" %}
{% endblock %}

{% block scripts %}
<script src="/js/site.js" defer></script>
{% endblock %}
