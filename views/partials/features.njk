<section class="sec" id="editorfeat" aria-labelledby="editorfeat-h">
<div class="wrap">
<div class="hiw-head rv">
<span class="eyebrow">{{ t.features.eyebrow }}</span>
<h2 id="editorfeat-h">{{ t.features.h2_html | safe }}</h2>
<p class="lead">{{ t.features.lead }}</p>
</div>
<div class="feat-grid rv">

<article class="feat-card">
<h3>{{ t.features.f1.h3 }}</h3>
<p>{{ t.features.f1.p }}</p>
<div class="feat-visual"><div class="fv15">
<div class="fv15-win">
<div class="fv15-top"><span class="t">{{ t.features.f1.winTitle }}</span></div>
<div class="fv15-body">
<div class="fv15-rail"><i class="on"></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="fv15-panel"><s></s><s class="on"></s><s></s><s></s><s></s></div>
<div class="fv15-prev"><div class="fv15-mon"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/conf.webp') }}" alt="{{ t.media.editorClip }}" width="896" height="1344"><span class="fv15-crop"><i></i><i></i></span></div></div>
</div>
<div class="fv15-tl">
<span class="fv15-ph"></span>
<div class="fv15-lane"><span class="lb">{{ t.features.f1.laneSubs }}</span><span class="seg" style="flex:2;background:var(--ek-purple)"></span><span class="seg" style="flex:1;background:var(--ek-purple-b)"></span><span class="seg" style="flex:1.4;background:var(--ek-purple)"></span></div>
<div class="fv15-lane"><span class="lb">{{ t.features.f1.laneFaces }}</span><span class="seg" style="flex:1;background:var(--ek-ok)"></span><span class="seg" style="flex:2.2;background:transparent"></span><span class="seg" style="flex:1.2;background:var(--ek-ok-bg);border:1px solid var(--ek-ok)"></span></div>
<div class="fv15-lane"><span class="lb">{{ t.features.f1.laneBlur }}</span><span class="seg" style="flex:.8;background:transparent"></span><span class="seg" style="flex:1.4;background:#F79009"></span><span class="seg" style="flex:2;background:transparent"></span></div>
<div class="fv15-lane"><span class="lb">{{ t.features.f1.laneAudio }}</span><span class="seg" style="flex:1;background:var(--ek-line-2)"></span><span class="seg" style="flex:1.6;background:var(--ek-line)"></span><span class="seg" style="flex:1;background:var(--ek-line-2)"></span></div>
</div>
</div>
</div></div>
</article>

<article class="feat-card">
<h3>{{ t.features.f2.h3 }}</h3>
<p>{{ t.features.f2.p }}</p>
<div class="feat-visual"><div class="fv9">
<div class="fv9-side">
<div class="fv9-text" style="max-width:200px">
<div class="row"><span class="k">{{ t.features.f2.srcLabel }}</span><span class="v"><span dir="{{ t.features.f2.srcDir }}">{{ t.features.f2.demo1Src }}</span></span></div>
<div class="row tr"><span class="k">{{ t.features.f2.trLabel }}</span><span class="v"><span dir="{{ t.features.f2.trDir }}">{{ t.features.f2.demo1Tr }}</span><span class="fv9-blink">|</span></span></div>
</div>
<div class="fv9-text g" style="max-width:200px">
<div class="row"><span class="k">{{ t.features.f2.srcLabel }}</span><span class="v"><span dir="{{ t.features.f2.srcDir }}">{{ t.features.f2.demo2Src }}</span></span></div>
<div class="row tr"><span class="k">{{ t.features.f2.trLabel }}</span><span class="v"><span dir="{{ t.features.f2.trDir }}">{{ t.features.f2.demo2Tr }}</span></span></div>
</div>
</div>
<div class="fv9-phone" style="border-radius:6px">
<img loading="lazy" decoding="async" src="{{ asset('/media/opt/presser-woman.webp') }}" alt="{{ t.media.speakerSubs }}" width="1500" height="1026">
<span class="fv9-timer">01:05</span>
<span class="fv9-cap"><span class="l1">{{ t.features.f2.capL1 }}</span><span class="l2">{{ t.features.f2.capL2 }}</span></span>
</div>
</div></div>
</article>

<article class="feat-card">
<h3>{{ t.features.f3.h3 }}</h3>
<p>{{ t.features.f3.p }}</p>
<div class="feat-visual"><div class="fv14b">
<div class="fv14b-frame"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/brand-frame.webp') }}" alt="{{ t.media.brandBefore }}" width="1333" height="2000"><span class="fv14b-lbl">{{ t.features.f3.before }}</span></div>
<svg class="fv14b-arr" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
<div class="fv14b-el">
<div class="fv14b-chip"><span class="k">{{ t.features.f3.logo }}</span><img loading="lazy" decoding="async" src="{{ asset('/media/logo.svg') }}" alt="" width="382" height="108"></div>
<div class="fv14b-chip"><span class="k">{{ t.features.f3.colours }}</span><span class="fv14b-sw"><i style="background:#604D8C"></i><i style="background:#101828"></i><i style="background:#F9D24A"></i></span></div>
<div class="fv14b-chip"><span class="k">{{ t.features.f3.font }}</span><span class="fv14b-font">{{ t.features.f3.fontName }}</span></div>
<div class="fv14b-chip"><span class="k">{{ t.features.f3.template }}</span><span class="fv14b-tpl"><i></i><i></i></span></div>
</div>
<svg class="fv14b-arr" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
<div class="fv14b-frame"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/brand-frame.webp') }}" alt="{{ t.media.brandAfter }}" width="1333" height="2000"><span class="lg"><img loading="lazy" decoding="async" src="{{ asset('/media/logo.svg') }}" alt="" width="382" height="108"></span><span class="cap">{{ t.features.f3.cap }}</span><span class="bar">{{ t.features.f3.bar }}</span></div>
</div></div>
</article>

<article class="feat-card">
<h3>{{ t.features.f4.h3 }}</h3>
<p>{{ t.features.f4.p }}</p>
<div class="feat-visual" style="padding:20px"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/cover-suggest-v2.webp') }}" alt="{{ t.media.coverSuggest }}" width="1500" height="822" style="width:100%;height:100%;object-fit:contain;object-position:bottom center"></div>
</article>

<article class="feat-card">
<h3>{{ t.features.f5.h3 }}</h3>
<p>{{ t.features.f5.p }}</p>
<div class="feat-visual" style="padding:22px"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/face-detection-reel-2.webp') }}" alt="{{ t.media.faceDetect }}" width="1500" height="844" style="width:100%;height:100%;object-fit:contain;object-position:bottom center"></div>
</article>

<article class="feat-card">
<h3>{{ t.features.f6.h3 }}</h3>
<p>{{ t.features.f6.p }}</p>
<div class="feat-visual" style="padding:22px"><img loading="lazy" decoding="async" src="{{ asset('/media/opt/schedule-publish-v2.webp') }}" alt="{{ t.media.schedule }}" width="1500" height="829" style="width:100%;height:100%;object-fit:contain;object-position:bottom center"></div>
</article>

</div>
</div>
</section>
