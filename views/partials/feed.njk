<section class="sec sec-soft" id="feedsec" aria-labelledby="feedsec-h">
<div class="wrap">
<div class="hiw-head rv">
<span class="eyebrow">{{ t.feed.eyebrow }}</span>
<h2 id="feedsec-h">{{ t.feed.h2 }}</h2>
<p class="lead">{{ t.feed.lead }}</p>
</div>
{# .fs-pin is the tall scroll track the animation is scrubbed through: from
   831px up the frame sticks inside it while the page scrolls past. #}
<div class="fs-pin" id="fs-pin"><div class="fs-anim rv"><iframe id="fs-anim-frame" src="/funnel/{{ locale }}" title="{{ t.feed.iframeTitle }}" loading="lazy" scrolling="no"></iframe></div></div>
</div>
</section>
