<footer class="ftr ftr-min">
<div class="wrap ftr-min-in">
<a class="ftr-mark" href="#top" aria-label="{{ t.meta.siteName }}"><img src="{{ asset('/media/logo-light.svg') }}" alt="{{ t.meta.siteName }}" width="88" height="22"></a>
<nav class="ftr-legal" aria-label="{{ t.legal.footerAria }}"><a href="/{{ locale }}/privacy"{% if pagePath == '/privacy' %} aria-current="page"{% endif %}>{{ t.legal.privacyLink }}</a><a href="/{{ locale }}/terms"{% if pagePath == '/terms' %} aria-current="page"{% endif %}>{{ t.legal.termsLink }}</a></nav>
<p class="ftr-cr">{{ t.footer.copy }}</p>
</div>
</footer>
