<a class="skip" href="#feedsec">{{ t.skip }}</a>
<header class="hdr" id="hdr" data-solid="0">
<div class="wrap-wide hdr-in">
<a class="hdr-logo" href="#top" aria-label="{{ t.nav.ariaHome }}"><img class="lg-l" src="{{ asset('/media/logo-light.svg') }}" alt="{{ t.meta.siteName }}" width="96" height="27"><img class="lg-d" src="{{ asset('/media/logo.svg') }}" alt="" width="96" height="27"></a>
<nav class="nav" aria-label="{{ t.nav.ariaMain }}">
<a href="#feedsec">{{ t.nav.feed }}</a>
<a href="#steps">{{ t.nav.how }}</a>
<a href="#editorfeat">{{ t.nav.features }}</a>
<a href="#usecases">{{ t.nav.usecases }}</a>
<a href="#faqb">{{ t.nav.faq }}</a>
</nav>
<div class="hdr-cta">
{% include "partials/lang-switch.njk" %}
<a class="btn btn-p btn-sm" href="#contact">{{ t.nav.contact }}</a>
{# Two icons, one button: CSS swaps them on aria-expanded so the burger
   becomes the close control once the full-screen menu is up. #}
<button class="burger" type="button" id="burger" aria-expanded="false" aria-controls="mnav" aria-label="{{ t.nav.ariaMenu }}"><svg class="ic-m" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg><svg class="ic-x" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
</div>
</div>
<div class="mnav-scrim" id="mnav-scrim" data-open="0" aria-hidden="true"></div>
<div class="mnav" id="mnav" data-open="0">
<div class="mnav-bar">
<button class="mnav-x" type="button" id="mnav-x" aria-label="{{ t.nav.ariaCloseMenu }}"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
<img class="mnav-logo" src="{{ asset('/media/logo.svg') }}" alt="{{ t.meta.siteName }}" width="96" height="27">
</div>
<div class="wrap mnav-body">
<ul>
<li><a href="#feedsec">{{ t.nav.feed }}</a></li>
<li><a href="#steps">{{ t.nav.how }}</a></li>
<li><a href="#editorfeat">{{ t.nav.features }}</a></li>
<li><a href="#usecases">{{ t.nav.usecases }}</a></li>
<li><a href="#problem">{{ t.nav.problem }}</a></li>
<li><a href="#faqb">{{ t.nav.faq }}</a></li>
<li><a href="{{ appUrl }}">{{ t.nav.login }}</a></li>
</ul>
{# The export faked a thank-you here. This one posts to /api/contact like the
   other two forms; site.js wires all three from the same strings blob. #}
<form class="mnav-form" id="mnav-form" action="/api/contact" method="post" novalidate data-locale="{{ locale }}">
<input id="m-email" name="email" type="email" aria-label="{{ t.contact.emailLabel }}" dir="ltr" autocomplete="email" placeholder="name@company.com" required>
<div class="ctc-hp" aria-hidden="true"><label><span>Company</span><input name="company" type="text" tabindex="-1" autocomplete="off"></label></div>
<button class="btn btn-p" type="submit">{{ t.nav.contact }}</button>
</form>
<p class="mnav-msg" id="mnav-msg" role="status" aria-live="polite"></p>
{% set swId = 'langsw-m' %}{% set swVariant = 'langsw-m' %}{% set swTrigger = 'lang-row' %}
{% include "partials/lang-switch.njk" %}
</div>
</div>
</header>
