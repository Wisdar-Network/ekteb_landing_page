<section class="hero" id="hero" data-in="0" aria-labelledby="hero-h">
<div class="wrap-wide hero-in">
<div class="hero-top">
<span class="hero-eyb up" style="--d:40ms"><i></i>{{ t.hero.eyebrow }}</span>
<h1 id="hero-h"><span class="ln up" style="--d:120ms">{{ t.hero.line1 }}</span><span class="ln ln2 up" style="--d:240ms">{{ t.hero.line2 }}</span></h1>
<p class="lead up" style="--d:420ms">{{ t.hero.lead }}</p>
<div class="hero-btns up" style="--d:520ms">
<a class="btn btn-p" href="#contact">{{ t.hero.ctaPrimary }}</a>
<a class="btn btn-s" href="#steps">{{ t.hero.ctaSecondary }}</a>
</div>
</div>
</div>
<div class="hero-stage">
<div class="hp-fr hp-shot" id="hero-slot"><div class="hp-turn"><img src="/media/opt/hero-app.webp" alt="{{ t.media.hero }}" width="1363" height="764" fetchpriority="high" decoding="async"></div></div>
</div>
</section>
