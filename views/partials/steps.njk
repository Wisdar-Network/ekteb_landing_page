<section class="sec" id="steps" aria-labelledby="steps-h">
<div class="wrap">
<div class="hiw-head rv">
<span class="eyebrow">{{ t.steps.eyebrow }}</span>
<h2 id="steps-h">{{ t.steps.h2 }}</h2>
</div>
<div class="hiw-grid rv">

<article class="hiw-card">
<div class="hiw-stage">
<div class="hiw-col">
<div class="hiw-feed"><img loading="lazy" decoding="async" src="/media/opt/t5.webp" alt="{{ t.media.feedItem }}" width="280" height="158"><span class="m"><span class="t">{{ t.steps.c1.feedTitle }}</span><span class="s">{{ t.steps.c1.feedMeta }}</span></span><span class="pk">{{ t.steps.c1.pick }}</span></div>
<div class="hiw-fld"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="url" dir="ltr">youtube.com/watch?v=<b>ht4ke…</b></span><span class="go">{{ t.steps.c1.add }}</span></div>
<div class="hiw-set"><span>{{ t.steps.c1.setLang }}</span><span>9:16</span><span>{{ t.steps.c1.setBrand }}</span></div>
</div>
</div>
<h3>{{ t.steps.c1.h3_html | safe }}</h3>
<p>{{ t.steps.c1.p }}</p>
</article>

<article class="hiw-card">
<div class="hiw-stage">
<div class="hiw-tasks">
<div class="hiw-task"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect width="18" height="14" x="3" y="5" rx="2"/><path d="M7 15h4M15 15h2M7 11h2M13 11h4"/></svg><span class="lb">{{ t.steps.c2.t1 }}</span><span class="ic done"><svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6.5"/></svg></span></div>
<div class="hiw-task"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="10" cy="8" r="5"/><path d="M2 21a8 8 0 0 1 10.434-7.62"/><circle cx="18" cy="18" r="3"/><path d="m22 22-1.9-1.9"/></svg><span class="lb">{{ t.steps.c2.t2 }}</span><span class="ic run"></span></div>
<div class="hiw-task"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/></svg><span class="lb">{{ t.steps.c2.t3 }}</span><span class="ic run"></span></div>
</div>
<div class="hiw-clip"><img loading="lazy" decoding="async" src="/media/opt/conf.webp" alt="{{ t.media.stepClip }}" width="896" height="1344"><span class="cap">{{ t.steps.c2.cap }}</span></div>
</div>
<h3>{{ t.steps.c2.h3_html | safe }}</h3>
<p>{{ t.steps.c2.p }}</p>
</article>

<article class="hiw-card">
<div class="hiw-stage">
<div class="hiw-plats">
<span title="TikTok"><i style="background:#111"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M15 3v10.5a4.5 4.5 0 1 1-4-4.47"/><path d="M15 3c.6 2.6 2.2 4.1 5 4.4"/></svg></i></span>
<span title="Instagram"><i style="background:linear-gradient(45deg,#FEDA75,#D62976,#962FBF)"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/></svg></i></span>
<span title="YouTube"><i style="background:#FF0000"><svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M10 8.5l6 3.5-6 3.5z"/></svg></i></span>
<span title="Facebook"><i style="background:#0866FF"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14.5 8h2"/><path d="M14.5 22V9.5a2.5 2.5 0 0 1 2.5-2.5"/><path d="M11 13h6"/></svg></i></span>
</div>
<div class="hiw-clip"><img loading="lazy" decoding="async" src="/media/opt/conf.webp" alt="{{ t.media.stepPlatforms }}" width="896" height="1344"><span class="cap">{{ t.steps.c3.cap }}</span></div>
<span class="hiw-badge">4K · 60fps</span>
</div>
<h3>{{ t.steps.c3.h3_html | safe }}</h3>
<p>{{ t.steps.c3.p }}</p>
</article>

</div>
<div class="sec-cta rv"><a class="btn btn-p" href="#contact">{{ t.steps.cta }}</a></div>
</div>
</section>
